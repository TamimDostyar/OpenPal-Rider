{
  "expo": {
    "name": "PalRiders",
    "slug": "palrider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "openpalrider",
    "icon": "./asset/app-icon.png",
    "ios": {
      "supportsTablet": false,
      "buildNumber": "2",
      "bundleIdentifier": "com.tamimdostyar.openpal",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./asset/app-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.tamimdostyar.openpal"
    },
    "splash": {
      "image": "./asset/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./asset/app-icon.png",
          "color": "#FFFFFF"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "OpenPal needs calendar access to add your accepted rides to your schedule."
        }
      ]
    ],
    "notification": {
      "icon": "./asset/app-icon.png",
      "color": "#FFFFFF"
    },
    "extra": {
      "eas": {
        "projectId": "f8ba6cea-256e-4f83-bf0d-7d856538b217"
      }
    },
    "owner": "dostah01"
  }
}
