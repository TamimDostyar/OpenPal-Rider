{
  "expo": {
    "name": "OpenPal Rider",
    "slug": "openpal-rider-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "openpalrider",
    "icon": "./asset/app-icon.png",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./asset/app-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "splash": {
      "image": "./asset/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6EF"
    },
    "plugins": [
      "expo-asset",
      "@react-native-community/datetimepicker"
    ]
  }
}
